{
  "name": "opintel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0 && depcruise --config .dependency-cruiser.cjs src --output-type err",
    "test": "vitest run --passWithNoTests",
    "migrate:up": "tsx src/platform/db/migrate.ts up",
    "migrate:down": "tsx src/platform/db/migrate.ts down",
    "migrate:status": "tsx src/platform/db/migrate.ts status"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.36",
    "dotenv": "^16.0.0",
    "pg": "^8.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "^6.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@11.0.0"
}
