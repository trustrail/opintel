{
  "name": "opintel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:up": "tsx scripts/dev-up.ts",
    "dev:demo": "tsx scripts/dev-demo.ts",
    "sidecar:openapi": "tsx scripts/sidecar-openapi.ts",
    "dev:sidecar": "tsx sidecar/supervise.ts",
    "dev:api": "tsx --watch scripts/dev-api.ts",
    "check": "node scripts/gate.mjs",
    "check:ui": "npm run check",
    "check:data": "npm run test:performance && npm run check && npm run test:tokenization-collision && npm run test:ephemerality",
    "check:release": "npm run check && npm run typecheck:conformance && npm run test:bypass && npm run test:performance && npm run test:tokenization-collision && npm run test:ephemerality",
    "typecheck": "tsc --noEmit",
    "typecheck:conformance": "tsc --project tsconfig.conformance.json",
    "lint": "eslint src scripts sidecar --max-warnings 0 && depcruise --config .dependency-cruiser.cjs src --output-type err",
    "test": "tsx scripts/test.ts",
    "test:bypass": "tsx scripts/test-bypass.ts",
    "test:ephemerality": "node scripts/ephemerality/run.mjs",
    "test:browser": "npm run test:conformance && npm run test:smoke",
    "test:conformance": "node scripts/visual-docker.mjs --config=playwright.conformance.config.ts",
    "migrate:up": "tsx src/platform/db/migrate.ts up",
    "migrate:down": "tsx src/platform/db/migrate.ts down",
    "migrate:status": "tsx src/platform/db/migrate.ts status",
    "spicedb:schema": "tsx src/modules/authz/infrastructure/load-schema.ts",
    "sidecar:register": "tsx sidecar/ingest/command.ts",
    "sidecar:pin": "tsx sidecar/pin-command.ts",
    "test:performance": "tsx scripts/test-performance.ts --config vitest.performance.config.ts",
    "demo:pack": "tsx scripts/demo-pack.ts",
    "test:tokenization-collision": "vitest run --config vitest.tokenization.config.ts",
    "sidecar:prepare-scanner": "tsx scripts/prepare-duckdb-scanner.ts",
    "test:deployment": "node scripts/ephemerality/run.mjs",
    "build:production": "npm run build && node scripts/check-production-artifact.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@authzed/authzed-node": "^1.6.1",
    "@duckdb/node-api": "1.5.6-r.1",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@xqmsg/jssdk-core": "2.0.6",
    "csv-parse": "^7.0.2",
    "decimal.js": "10.6.0",
    "dotenv": "^16.0.0",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.2.1",
    "openid-client": "^6.8.8",
    "pg": "^8.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "redis": "^6.2.1",
    "saxes": "^6.0.0",
    "transliteration": "2.6.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "dependency-cruiser": "^16.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "smtp-server": "^3.21.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@11.0.0"
}
