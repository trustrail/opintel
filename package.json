{
  "name": "opintel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:up": "tsx scripts/dev-up.ts",
    "sidecar:openapi": "tsx scripts/sidecar-openapi.ts",
    "dev:sidecar": "tsx sidecar/start.ts",
    "dev:api": "tsx --watch src/platform/http/start.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts sidecar --max-warnings 0 && depcruise --config .dependency-cruiser.cjs src --output-type err",
    "test": "tsx scripts/test.ts",
    "test:visual": "playwright test",
    "test:visual:performance": "playwright test --config playwright.performance.config.ts",
    "test:visual:update": "playwright test --update-snapshots",
    "migrate:up": "tsx src/platform/db/migrate.ts up",
    "migrate:down": "tsx src/platform/db/migrate.ts down",
    "migrate:status": "tsx src/platform/db/migrate.ts status",
    "spicedb:schema": "tsx src/modules/authz/infrastructure/load-schema.ts",
    "sidecar:register": "tsx sidecar/ingest/command.ts",
    "test:performance": "tsx scripts/test.ts --config vitest.performance.config.ts",
    "demo:pack": "tsx scripts/demo-pack.ts"
  },
  "dependencies": {
    "@authzed/authzed-node": "^1.6.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.0.0",
    "exceljs": "^4.4.0",
    "openid-client": "^6.8.8",
    "pg": "^8.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "^6.2.1",
    "saxes": "^6.0.0",
    "transliteration": "2.6.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@11.0.0"
}
