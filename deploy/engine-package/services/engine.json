{
  "services": {
    "engine": {
      "image": "${ENGINE_IMAGE:?set engine image digest}",
      "platform": "${PLATFORM:?set linux/amd64 or linux/arm64}",
      "network_mode": "container:${ENGINE_NETWORK_CONTAINER:?start local egress companion first}",
      "read_only": true,
      "user": "65534:65534",
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "pids_limit": 256,
      "mem_limit": "${ENGINE_MEMORY:-1g}",
      "memswap_limit": "${ENGINE_MEMORY:-1g}",
      "ulimits": {
        "core": 0
      },
      "tmpfs": [
        "/tmp:ro,noexec,nosuid,nodev,size=1m",
        "/dev/shm:ro,noexec,nosuid,nodev,size=1m"
      ],
      "environment": {
        "SIDECAR_CONFIG_FILE": "/config/service.json",
        "UV_USE_IO_URING": "0",
        "ENGINE_EGRESS_CONTROL": "1"
      },
      "env_file": [
        "${ENGINE_ENV_FILE:?set engine runtime environment}"
      ],
      "volumes": [
        "${ENGINE_CONFIG_DIRECTORY:?set engine config directory}:/config:ro",
        "${ENGINE_XQ_DIRECTORY:?set engine XQ directory}:/xq:ro",
        "${ENGINE_AUDIT_DIRECTORY:?set local audit directory}:/audit",
        "${ENGINE_CUSTODY_DIRECTORY:?set local custody directory}:/custody",
        "${ENGINE_INGEST_DIRECTORY:?set local ingest directory}:/ingest",
        "${ENGINE_STATE_DIRECTORY:?set engine-local state directory}/control/hosts:/etc/hosts:ro"
      ],
      "restart": "no"
    }
  }
}
