{
  "services": {
    "spicedb-postgres": {
      "extends": {
        "file": "../../images/upstream.json",
        "service": "postgres"
      },
      "platform": "${PLATFORM:?set linux/amd64 or linux/arm64}",
      "environment": {
        "POSTGRES_USER": "spicedb",
        "POSTGRES_DB": "spicedb",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/postgres-password"
      },
      "volumes": [
        "spicedb-data:/var/lib/postgresql/data",
        "${GATEWAY_SPICEDB_POSTGRES_PASSWORD_FILE:?set password file}:/run/secrets/postgres-password:ro"
      ],
      "ports": [
        "${GATEWAY_SPICEDB_POSTGRES_BIND_ADDRESS:-127.0.0.1}:${GATEWAY_SPICEDB_POSTGRES_PORT:-5433}:5432"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U spicedb"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 6,
        "start_period": "20s"
      },
      "restart": "unless-stopped"
    }
  },
  "volumes": {
    "spicedb-data": {}
  }
}
