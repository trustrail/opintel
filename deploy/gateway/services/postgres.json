{
  "services": {
    "postgres": {
      "extends": {
        "file": "../../images/upstream.json",
        "service": "postgres"
      },
      "platform": "${PLATFORM:?set linux/amd64 or linux/arm64}",
      "environment": {
        "POSTGRES_USER": "opintel",
        "POSTGRES_DB": "opintel",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/postgres-password"
      },
      "volumes": [
        "postgres-data:/var/lib/postgresql/data",
        "${GATEWAY_POSTGRES_PASSWORD_FILE:?set password file}:/run/secrets/postgres-password:ro"
      ],
      "ports": [
        "${GATEWAY_POSTGRES_BIND_ADDRESS:-127.0.0.1}:${GATEWAY_POSTGRES_PORT:-5432}:5432"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U opintel"
        ],
        "interval": "2s",
        "timeout": "2s",
        "retries": 15
      },
      "restart": "on-failure:3"
    }
  },
  "volumes": {
    "postgres-data": {}
  }
}
