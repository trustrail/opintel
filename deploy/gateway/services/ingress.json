{
  "services": {
    "ingress": {
      "extends": {
        "file": "../../images/upstream.json",
        "service": "ingress"
      },
      "platform": "${PLATFORM:?set linux/amd64 or linux/arm64}",
      "entrypoint": [
        "nginx"
      ],
      "command": [
        "-g",
        "daemon off;"
      ],
      "volumes": [
        "${GATEWAY_INGRESS_CONFIG_FILE:?set packaged nginx.conf}:/etc/nginx/nginx.conf:ro",
        "${GATEWAY_INGRESS_CERT_FILE:-${GATEWAY_CONFIG_DIRECTORY}/ingress-tls/server.pem}:/tls/console.pem:ro",
        "${GATEWAY_INGRESS_KEY_FILE:-${GATEWAY_CONFIG_DIRECTORY}/ingress-tls/server.key}:/tls/console.key:ro"
      ],
      "ports": [
        "${GATEWAY_CONSOLE_BIND_ADDRESS:-127.0.0.1}:${GATEWAY_CONSOLE_PORT:-443}:8443"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=32m"
      ],
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -q --no-check-certificate -O /dev/null https://127.0.0.1:8443/healthz"
        ],
        "interval": "10s",
        "timeout": "3s",
        "retries": 3
      }
    }
  }
}
