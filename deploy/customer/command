#!/usr/bin/env bash
# Parse the complete implementation before upgrade can replace this file.
main(){
set -euo pipefail
umask 077
export LC_ALL=C DOCKER_CLI_HINTS=false
root="$(cd "$(dirname "$0")" && pwd)"
command="$(basename "$0")"
[[ "$command" != command ]] || { command="${1:?command required}"; shift; }
if [[ "$command" == steps ]]; then exec 3<&0; fi
exec </dev/null
cd "$root"
fail(){ echo "$*" >&2; exit 1; }
[[ -f release.json && -f images.list && -f bootstrap.image ]] || fail 'This is not a complete Opintel package.'
type docker >/dev/null || fail 'Install and start Docker Desktop, then run this command again.'
docker info >/dev/null 2>&1 || fail 'Start Docker Desktop and wait until it is ready.'
platform="$(cat platform)"
case "$(uname -m):$platform" in arm64:linux/arm64|aarch64:linux/arm64|x86_64:linux/amd64) ;; *) fail 'This archive is for a different CPU. Use the matching package archive.';; esac
bootstrap="$(cat bootstrap.image)"
job(){ docker run --rm --pull never --network none --platform "$platform" --user "$(id -u):$(id -g)" -e PACKAGE_HOST_DIRECTORY="$root" -e PACKAGE_HOST_ADDRESS="${host_address:-}" -v "$root:/package" "$bootstrap" node scripts/operator/customer-install.js "$@"; }
compose(){ docker compose --ansi never --project-name "$(cat "$root/state/project-name")" --project-directory "$root" --env-file "$root/state/package.env" -f "$root/state/compose.json" "$@"; }
run(){ compose run --rm --no-deps --interactive=false -T "$@"; }
agent_api_temp=""; steps_tty=""
agent_tmpfs="/tmp:rw,noexec,nosuid,nodev,size=64m,mode=0700,uid=$(id -u),gid=$(id -g)"
agent_cleanup(){
 if [[ -n "$steps_tty" ]]; then stty "$steps_tty" <&3 || true; fi
 if [[ -n "$agent_api_temp" ]]; then rm -f "$agent_api_temp/api-key"; rmdir "$agent_api_temp" || true; fi
}
agent_api_key(){
 # Keep bind sources beneath the package: a remote/nested daemon may share only
 # this tree, not the caller's host TMPDIR. Never broaden the directory or key modes.
 agent_api_temp="$(mktemp -d "$root/.agent-api-XXXXXX")"; chmod 700 "$agent_api_temp"
 mkdir -p "$root/diagnostics"; chmod 700 "$root/diagnostics"
 docker run --rm --pull never --network none --platform "$platform" --user "$(id -u):$(id -g)" -e PACKAGE_HOST_DIRECTORY="$root" -v "$root/package.env:/input/package.env:ro" -v "$agent_api_temp:/output" -v "$root/diagnostics:/package/diagnostics" "$bootstrap" node scripts/operator/customer-install.js agent-api-key gateway
}
load_images(){
 [[ -f images.tar ]] || fail 'The offline image archive is missing.'
 echo 'Loading packaged images...'
 docker load --input images.tar > "$root/image-load.log" 2>&1 || fail 'Image loading failed; see image-load.log.'
 while IFS=' ' read -r image expected; do
  [[ -n "$image" ]] || continue
  actual="$(docker image inspect --platform "$platform" --format '{{.Id}}' "$image")"
  [[ "$actual" == "$expected" ]] || fail "Image identity mismatch: $image"
 done < images.list
}
start_services_internal(){
 if [[ "$(cat package-kind)" == gateway ]]; then
  compose up --detach --no-deps --pull never --wait postgres redis spicedb-postgres || return
  run migrations node src/platform/db/migrate.js up || return
  run spicedb-migrate || return
  compose up --detach --no-deps --pull never --wait spicedb || return
  run schema || return
  compose exec --interactive=false -T postgres psql -U opintel -d opintel -v ON_ERROR_STOP=1 -f /config/runtime-role.sql || return
  compose up --detach --no-deps --pull never --wait api console ingress || return
 else
  compose up --detach --no-deps --pull never --wait readiness || return
  run prepare > state/readiness-egress.json.next || return
  mv state/readiness-egress.json.next state/readiness-egress.json || return
  compose up --detach --no-deps --pull never --wait egress engine pairing || return
 fi
}
start_services(){
 echo 'Starting services and waiting for health...'
 mkdir -p state/operations; chmod 700 state/operations
 startup_log="state/operations/start-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
 touch "$startup_log"; chmod 600 "$startup_log"
 if ! start_services_internal > "$startup_log" 2>&1; then echo "Service startup failed. Details are retained in $startup_log." >&2; return 1; fi
 if grep -Eq 'WARN\[|level=warning' "$startup_log"; then echo "Startup reported a Compose warning. See $startup_log." >&2; return 1; fi
 echo 'Services are healthy.'
}
backup_install(){
 active_jobs="$(docker ps -q --filter "label=com.docker.compose.project=$(cat state/project-name)" --filter label=com.docker.compose.oneoff=True)"
 [[ -z "$active_jobs" ]] || fail 'Wait for the active operator job to finish before backup, restore or upgrade.'
 backup_directory="$root/backups/$(date -u +%Y%m%dT%H%M%SZ)-$$"
 mkdir -p "$backup_directory"; chmod 700 "$root/backups" "$backup_directory"
 compose ps --services --status running > "$backup_directory/running-services"
 compose stop
 tar -cf "$backup_directory/state.tar" --exclude='state/custody/escrow' --exclude='*/observer.credential' --exclude='state/incoming.json' state
 tar -xpf "$backup_directory/state.tar" -C "$backup_directory"
 rm "$backup_directory/state.tar"
 cp release.json "$backup_directory/release.json"
 cp trust.json "$backup_directory/trust.json"
 while IFS= read -r volume; do
  [[ -n "$volume" ]] || continue
  docker run --rm --pull never --network none --read-only --user 0:0 --platform "$platform" -v "$volume:/volume:ro" -v "$backup_directory:/backup" "$bootstrap" tar -czf "/backup/$volume.tar.gz" -C /volume .
 done < state/volumes.list
 job backup-record "$(cat package-kind)" "$backup_directory"
 echo "Private backup: $backup_directory"
}
resume_backup(){
 services=(); while IFS= read -r service; do [[ -z "$service" ]] || services+=("$service"); done < "$backup_directory/running-services"
 if [[ ${#services[@]} -gt 0 ]]; then compose up --detach --no-deps --pull never --wait "${services[@]}"; fi
}
if [[ "$command" == steps || "$command" == identities ]]; then
 if ! docker image inspect "$bootstrap" >/dev/null 2>&1; then load_images; fi
fi
case "$command" in
 backup) backup_install; resume_backup;;
 restore)
  [[ $# == 1 && -d "$1" ]] || fail 'Usage: ./restore BACKUP_DIRECTORY'
  restore_directory="$(cd "$1" && pwd)"
  load_images
  docker run --rm --pull never --network none --platform "$platform" --user "$(id -u):$(id -g)" -e PACKAGE_HOST_DIRECTORY="$root" -v "$root:/package" -v "$restore_directory:/restore:ro" "$bootstrap" node scripts/operator/customer-install.js validate-restore "$(cat package-kind)"
  if [[ -f state/project-name ]]; then
   [[ "$(cat state/project-name)" == "$(cat "$restore_directory/state/project-name")" ]] || fail 'This backup belongs to another install. Use its matching package directory.'
  else
   while IFS= read -r volume; do
    if docker volume inspect "$volume" >/dev/null 2>&1; then fail 'Backup volumes already exist. Run restore from their original installation directory.'; fi
   done < "$restore_directory/state/volumes.list"
  fi
  if [[ -f state/compose.json ]]; then backup_install; fi
  while IFS= read -r volume; do
   [[ -z "$(docker ps -q --filter "volume=$volume")" ]] || fail 'A running install uses a backup volume. Stop that install explicitly before restoring.'
  done < "$restore_directory/state/volumes.list"
  if [[ -d state ]]; then mv state "state.before-restore-$(date -u +%Y%m%dT%H%M%SZ)-$$"; fi
  cp -pR "$restore_directory/state" state
  cp -p "$restore_directory/trust.json" trust.json
  mkdir -p state/custody/escrow; chmod 700 state/custody/escrow
  job rebase "$(cat package-kind)"
  while IFS= read -r volume; do
   [[ -n "$volume" ]] || continue
   docker volume create "$volume" >/dev/null
   docker run --rm --pull never --network none --read-only --user 0:0 --platform "$platform" -v "$volume:/volume" -v "$restore_directory:/restore:ro" "$bootstrap" sh -c 'find /volume -mindepth 1 -delete && tar -xpzf "$1" -C /volume' sh "/restore/$volume.tar.gz"
  done < state/volumes.list
  start_services; job status "$(cat package-kind)";;
 upgrade)
  [[ $# == 1 && -d "$1" ]] || fail 'Usage: ./upgrade NEW_PACKAGE_DIRECTORY'
  next_directory="$(cd "$1" && pwd)"
  [[ "$next_directory" != "$root" && "$(cat "$next_directory/package-kind")" == "$(cat package-kind)" && "$(cat "$next_directory/platform")" == "$platform" ]] || fail 'Upgrade needs a separate matching package.'
  backup_install
  for file in "$next_directory"/*; do
   case "$(basename "$file")" in command|"$command"|state|backups|package.env|identity-bundles|public-identities|trust.json|*.log) continue;; esac
   [[ "$(basename "$file")" == identities && -d "$root/identities" ]] && continue
   cp -pR "$file" "$root/"
  done
  # Package entrypoints are copies of command; replace the executing entrypoint last.
  if [[ -f "$next_directory/command" && "$command" != command ]]; then cp -p "$next_directory/command" "$root/command"; fi
  cp -p "$next_directory/$command" "$root/$command"
  bootstrap="$(cat bootstrap.image)"; load_images; job upgrade "$(cat package-kind)"; start_services; job status "$(cat package-kind)";;
 install)
  mkdir -p diagnostics; chmod 700 diagnostics
  install_log="diagnostics/install-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
  load_images > "$install_log" 2>&1 || fail "Image loading failed. Log: $install_log"
  if command -v ipconfig >/dev/null 2>&1; then
   host_interface="$(route -n get default 2>/dev/null | awk '/interface:/{print $2}' || true)"
   host_address="$(ipconfig getifaddr "$host_interface" 2>/dev/null || true)"
  else host_address="$(hostname -I 2>/dev/null | awk '{print $1}')"; fi
  [[ -n "$host_address" ]] || fail 'Connect this Mac to the LAN, then run ./install again.'
  job initialize "$(cat package-kind)" >> "$install_log" 2>&1 || { cat "$install_log" >&2; fail "Installation initialization failed. Log: $install_log"; }
  start_services >> "$install_log" 2>&1 || { cat "$install_log" >&2; fail "Installation startup failed. Log: $install_log"; }
  if [[ "$(cat package-kind)" == gateway ]]; then run operator node scripts/operator/customer-operator.js initial-owner >> "$install_log" 2>&1 || { cat "$install_log" >&2; fail "Owner claim failed. Log: $install_log"; }; fi
  job installed "$(cat package-kind)";;
 start) [[ -f state/compose.json ]] || fail 'Run ./install first.'; start_services; job status "$(cat package-kind)";;
 stop) compose stop;;
 status) job status "$(cat package-kind)"; compose ps --all;;
 pairing-code) job pairing-code "$(cat package-kind)";;
 sources)
  [[ "$(cat package-kind)" == engine && -f state/installed.json ]] || fail 'Run ./sources on an installed engine package.'
  source_action="${1:-}"; shift || true
  source_args=("$source_action")
  if [[ "$source_action" == list && $# == 0 ]]; then :
  elif [[ "$source_action" == remove && $# == 1 ]]; then source_args+=("$1")
  elif [[ "$source_action" == add && $# -ge 1 ]]; then
   source_name="$1"; shift
   mkdir -p state/operations; chmod 700 state/operations
   source_input="$(mktemp "$root/state/operations/source-input.XXXXXX")"; chmod 600 "$source_input"
   trap 'rm -f "$source_input"' EXIT
   trap 'exit 130' INT
   trap 'exit 143' HUP TERM
   if [[ $# == 0 ]]; then
    exec 3</dev/tty || fail 'Interactive source entry needs a terminal; automation must use --host, --port, --database, --user and --password-file.'
    printf 'Host: ' >&2; IFS= read -r source_host <&3
    printf 'Port [5432]: ' >&2; IFS= read -r source_port <&3; source_port="${source_port:-5432}"
    printf 'Database: ' >&2; IFS= read -r source_database <&3
    printf 'User: ' >&2; IFS= read -r source_user <&3
    printf 'Password: ' >&2; IFS= read -r -s source_password <&3; printf '\n' >&2
    exec 3<&-
    printf '%s\0' "$source_host" "$source_port" "$source_database" "$source_user" "$source_password" > "$source_input"
    unset source_password
   else
    source_host= source_port= source_database= source_user= source_password_file=
    while [[ $# -gt 0 ]]; do
     [[ $# -ge 2 ]] || fail 'Each source flag needs a value.'
     case "$1" in --host) source_host="$2";; --port) source_port="$2";; --database) source_database="$2";; --user) source_user="$2";; --password-file) source_password_file="$2";; *) fail 'Unknown source flag.';; esac
     shift 2
    done
    [[ -n "$source_host" && -n "$source_port" && -n "$source_database" && -n "$source_user" && -f "$source_password_file" && ! -L "$source_password_file" ]] || fail 'Automation requires --host, --port, --database, --user and --password-file.'
    if [[ "$(uname -s)" == Darwin ]]; then source_password_mode="$(stat -f %Lp "$source_password_file")"; else source_password_mode="$(stat -c %a "$source_password_file")"; fi
    [[ "$source_password_mode" == 600 ]] || fail 'Password file must have mode 600.'
    printf '%s\0' "$source_host" "$source_port" "$source_database" "$source_user" > "$source_input"
    cat "$source_password_file" >> "$source_input"; printf '\0' >> "$source_input"
   fi
   source_args+=("$source_name" "/package/state/operations/$(basename "$source_input")")
  else fail 'Usage: ./sources add NAME [--host HOST --port PORT --database DATABASE --user USER --password-file FILE] | list | remove NAME'; fi
  docker run --rm --pull never --network none --platform "$platform" --user "$(id -u):$(id -g)" -v "$root:/package" "$bootstrap" node scripts/operator/engine-sources.js "${source_args[@]}";;
 register-engine)
  [[ "$(cat package-kind)" == gateway && $# == 2 ]] || fail 'Usage: ./register-engine ENGINE_ADDRESS CODE'
  docker run --rm --pull never --add-host host.docker.internal:host-gateway --platform "$platform" --user "$(id -u):$(id -g)" -e PACKAGE_HOST_DIRECTORY="$root" -v "$root:/package" "$bootstrap" node scripts/operator/customer-install.js claim-engine gateway "$1" "$2"
  rm -f state/incoming.json
  compose up --detach --no-deps --pull never --force-recreate --wait api;;
 identities)
  [[ "$(cat package-kind)" == gateway && ${1:-} == add ]] || fail 'Usage: ./identities add EXPORT.zip [--device NAME] [--api-key-file FILE] | add --public-file FILE'
  shift
  public_identity_root="$root/public-identities"; if [[ -f state/installed.json ]]; then public_identity_root="$root/state/public-identities"; fi
  mkdir -p "$public_identity_root"; chmod 700 "$public_identity_root"
  if [[ ${1:-} == --public-file && $# == 2 ]]; then
   public_input="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"
   docker run --rm --pull never --network none --platform "$platform" --user "$(id -u):$(id -g)" -v "$public_input:/input/public.json:ro" -v "$public_identity_root:/public" "$bootstrap" node scripts/steps/identity-exchange.js public /input/public.json /public/associations.json
  else
   [[ -f "${1:-}" ]] || fail 'Supply the original XQ export ZIP.'
   export_directory="$(cd "$(dirname "$1")" && pwd)"; export_name="$(basename "$1")"; shift
   identity_args=(identities gateway "$export_name"); device_name=""; api_key_file=""; trap agent_cleanup EXIT
   while [[ $# -gt 0 ]]; do
    case "$1" in --device) [[ $# -ge 2 ]] || fail 'Missing device name.'; device_name="$2"; identity_args+=("$2"); shift 2;; --api-key-file) [[ $# -ge 2 ]] || fail 'Missing XQ API key file.'; api_key_file="$2"; shift 2;; *) fail 'Unknown identities flag.';; esac
   done
   mkdir -p identity-bundles; chmod 700 identity-bundles
   docker run --rm --pull never --network none --platform "$platform" --user "$(id -u):$(id -g)" -e PACKAGE_HOST_DIRECTORY="$root" -v "$root/identity-bundles:/package/identity-bundles" -v "$export_directory/$export_name:/import/export.zip:ro" "$bootstrap" node scripts/operator/customer-install.js "${identity_args[@]}"
   if [[ -z "$device_name" ]]; then [[ "$export_name" =~ -([0-9]+)\.[zZ][iI][pP]$ ]] || fail 'Original XQ export filename required.'; device_name="opintel-${BASH_REMATCH[1]}"; fi
   if [[ -z "$api_key_file" ]]; then agent_api_key; api_key_file="$agent_api_temp/api-key"; fi
   api_key_file="$(cd "$(dirname "$api_key_file")" && pwd)/$(basename "$api_key_file")"
   # Isolated agent job: no Compose service, database, gateway runtime env or keys.
   docker run --rm --pull never --platform "$platform" --user "$(id -u):$(id -g)" --read-only --tmpfs "$agent_tmpfs" --cap-drop ALL --security-opt no-new-privileges -v "$root/identity-bundles:/identity" -v "$public_identity_root:/public" -v "$api_key_file:/input/api-key:ro" "$bootstrap" node scripts/steps/identity-exchange.js exchange /identity "$device_name" /input/api-key /public/associations.json
  fi;;
 steps)
  [[ "$(cat package-kind)" == gateway ]] || fail 'Run ./steps from the gateway archive on the agent host.'
  # File flags cross the agent-job boundary as file mounts, never secret arguments.
  steps_args=(); steps_mounts=(); steps_environment=(); steps_interactive=(); steps_outputs=(); steps_destinations=(); steps_operation="${1:-}"; steps_index=0
  while [[ $# -gt 0 ]]; do
   case "$1" in
    --key-file|--session-file|--result|--xq-identity)
     if [[ "$1" == --xq-identity && "$steps_operation" == grant-access ]]; then [[ $# -ge 2 ]] || fail 'Missing device name.'; steps_args+=("$1" "$2"); shift 2; continue; fi
     [[ $# -ge 2 && -e "$2" && ! -L "$2" ]] || fail 'Input must be an existing file or identity directory, not a link.'
     steps_path="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"; steps_index=$((steps_index+1)); steps_target="/input/$steps_index"
     steps_mounts+=(--volume "$steps_path:$steps_target:ro"); steps_args+=("$1" "$steps_target"); shift 2;;
    --out|--key-out|--session-out)
     [[ $# -ge 2 ]] || fail 'Output file path is missing.'
     steps_parent="$(dirname "$2")"; mkdir -p "$steps_parent"; steps_parent="$(cd "$steps_parent" && pwd)"; steps_index=$((steps_index+1)); steps_target="/output/$steps_index"
     steps_destination="$steps_parent/$(basename "$2")"; [[ ! -e "$steps_destination" && ! -L "$steps_destination" ]] || fail 'Output file already exists; choose a new file.'
     steps_temporary="$(mktemp -d "$steps_parent/.steps-output-XXXXXX")"; chmod 700 "$steps_temporary"
     steps_outputs+=("$steps_temporary"); steps_destinations+=("$steps_destination")
     steps_mounts+=(--volume "$steps_temporary:$steps_target"); steps_args+=("$1" "$steps_target/result"); shift 2;;
    *) steps_args+=("$1"); shift;;
   esac
  done
  if [[ -f gateway-ca.pem ]]; then steps_mounts+=(--volume "$root/gateway-ca.pem:/trust/ca.pem:ro"); steps_environment+=(-e NODE_EXTRA_CA_CERTS=/trust/ca.pem)
  elif [[ -f state/ca.pem ]]; then steps_mounts+=(--volume "$root/state/ca.pem:/trust/ca.pem:ro"); steps_environment+=(-e NODE_EXTRA_CA_CERTS=/trust/ca.pem); fi
  if [[ "$steps_operation" == redeem-and-unseal ]]; then
   trap agent_cleanup EXIT
   steps_api_key="${STEPS_XQ_API_KEY_FILE:-}"; if [[ -z "$steps_api_key" ]]; then agent_api_key; steps_api_key="$agent_api_temp/api-key"; fi; steps_api_key="$(cd "$(dirname "$steps_api_key")" && pwd)/$(basename "$steps_api_key")"
   steps_mounts+=(--volume "$steps_api_key:/input/api-key:ro"); steps_environment+=(-e STEPS_XQ_API_KEY_FILE=/input/api-key)
  fi
  steps_tty=""; if [[ "$steps_operation" == sign-in ]]; then steps_interactive+=(--interactive); if [[ -t 3 ]]; then steps_tty="$(stty -g <&3)"; stty -echo <&3; trap agent_cleanup EXIT; fi; fi
  docker run --rm --pull never --add-host host.docker.internal:host-gateway --platform "$platform" --user "$(id -u):$(id -g)" --read-only --tmpfs "$agent_tmpfs" --cap-drop ALL --security-opt no-new-privileges ${steps_interactive[@]+"${steps_interactive[@]}"} ${steps_mounts[@]+"${steps_mounts[@]}"} ${steps_environment[@]+"${steps_environment[@]}"} "$bootstrap" node scripts/steps/main.js "${steps_args[@]}" <&3
  for (( steps_i=0; steps_i<${#steps_outputs[@]}; steps_i++ )); do
   ln "${steps_outputs[$steps_i]}/result" "${steps_destinations[$steps_i]}" || fail 'Output could not be published; the private staging directory was retained.'
   rm "${steps_outputs[$steps_i]}/result"; rmdir "${steps_outputs[$steps_i]}"
  done;;
 xq-check)
  if [[ $# == 0 ]]; then run operator node scripts/operator/customer-operator.js xq-check
  elif [[ $# == 2 && "$1" == --roundtrips && "$2" == 200 ]]; then
   run operator node scripts/operator/customer-operator.js xq-check
   run demo-tools node scripts/operator/demo.js xq-roundtrip 200
  else fail 'Usage: ./xq-check [--roundtrips 200]'; fi;;
 owner-claim|invite|users|mail-test) run operator node scripts/operator/customer-operator.js "$command" "$@";;
 demo) if [[ ${1:-} == soak ]]; then shift; run demo-tools node scripts/operator/demo.js customer-soak "$@"; else run demo-tools node scripts/operator/demo.js "$@"; fi;;
 *) fail 'Unknown package command.';;
esac
}
# Exit in the same parsed command list: never read a replacement file after main.
main "$@"; exit $?
