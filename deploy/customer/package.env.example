# Fill these values before ./install. Keep this file private.
APP_BASE_URL=https://gateway.example.com
OWNER_EMAIL=owner@example.com
OPINTEL_XQ_API_KEY=
OPINTEL_XQ_DASHBOARD_API_KEY=
OPINTEL_XQ_SENDER_ALIAS=
OPINTEL_XQ_SENDER_ACCESS_TOKEN=
OPINTEL_XQ_TEAM_ID=
SMTP_HOST=smtp.mail.us-east-1.awsapps.com
SMTP_PORT=465
SMTP_USER=noreply@trustrail.io
SMTP_PASSWORD=
SMTP_SENDER=noreply@trustrail.io
SMTP_TLS_MODE=implicit
# Optional existing TLS identity: provide both absolute paths or neither.
# GATEWAY_INGRESS_CERT_FILE=
# GATEWAY_INGRESS_KEY_FILE=

# Private gateway/engine HTTP/2 transport. Use matching values on both hosts.
ENGINE_TRANSPORT_MAX_SESSIONS=1
ENGINE_TRANSPORT_MAX_CONCURRENT_STREAMS=32
ENGINE_TRANSPORT_IDLE_TIMEOUT_MS=60000
ENGINE_TRANSPORT_MAX_SESSION_AGE_MS=600000
ENGINE_TRANSPORT_CONNECT_TIMEOUT_MS=5000
ENGINE_TRANSPORT_PING_INTERVAL_MS=15000

# Detailed engine transport phase records; normal operation uses info.
LOG_LEVEL=info
