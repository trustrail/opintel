# Application connection. Uses a login role that owns nothing and assumes
# opintel_app, opintel_platform or opintel_platform_admin per scope.
DATABASE_URL=postgres://opintel:opintel@localhost:5432/opintel

# Migrations only. Connects as the schema owner.
MIGRATION_DATABASE_URL=postgres://opintel:opintel@localhost:5432/opintel

# Development API refuses pending migrations by default. Opt in to apply them.
# DEV_AUTO_MIGRATE=1

TEST_DATABASE_URL=postgres://opintel:opintel@localhost:5432/opintel_test
REDIS_URL=redis://localhost:6379
API_PORT=3000
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_TOKEN=devkey
SESSION_SECRET=change-me
MAGIC_LINK_TTL=900
APP_BASE_URL=http://localhost:5173
MAIL_PROVIDER=file
MAIL_OUTPUT_DIR=./tmp/mail
PAL_PROVIDER=
PAL_MODEL=
EMBEDDING_MODEL=
KEY_CUSTODY_PROVIDER=local
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional platform OIDC providers. Company providers use company_idp instead.
# These need real OAuth clients registered with Google and Microsoft Entra.
# Google and Microsoft appear only when issuer, client ID and a resolvable
# secret reference are configured. Readiness is checked on each provider lookup;
# no discovery probe or sign-in is performed and no secret enters the response.
# Development loads .env at process start; restart dev:api after editing it.
# Resolution checks readiness through the existing secret store on every lookup.
# With neither platform provider configured, sign-in offers magic link alone
# (plus any enabled company providers). The screen has no hard-coded fallback.
# Enforced company SSO retains audited magic-link recovery for company admins.
# Uncomment and replace the placeholders below to enable platform sign-in.
# APP_BASE_URL (also used by magic links above) is the browser-facing origin.
# APP_BASE_URL=http://localhost:5173
# Register these exact redirect URIs for that local origin:
#   http://localhost:5173/auth/oidc/oidc:google/callback
#   http://localhost:5173/auth/oidc/oidc:entra/callback
# Use the corresponding APP_BASE_URL origin for other deployments.
# OIDC_GOOGLE_ISSUER=<Google OIDC issuer>
# OIDC_GOOGLE_CLIENT_ID=<registered Google OAuth client ID>
# OIDC_GOOGLE_CLIENT_SECRET_REF=secret://oidc/google
# OPINTEL_SECRET_OIDC_GOOGLE=<Google OAuth client secret>
# OIDC_GOOGLE_SCOPE=openid email profile
# OIDC_ENTRA_ISSUER=<Microsoft Entra OIDC issuer>
# OIDC_ENTRA_CLIENT_ID=<registered Microsoft application client ID>
# OIDC_ENTRA_CLIENT_SECRET_REF=secret://oidc/entra
# OPINTEL_SECRET_OIDC_ENTRA=<Microsoft OAuth client secret value>
# OIDC_ENTRA_SCOPE=openid email profile
# Scope defaults to "openid email profile" when omitted.
# Secret refs above resolve to the matching OPINTEL_SECRET_* variables.
# Never put a literal secret in *_CLIENT_SECRET_REF.

# Application identity/trust only: strict JSON with caFile, certFile, keyFile.
# Engine addresses, certificate pins and source/custody mappings live in Settings.
# APPLICATION_TLS_CONFIG=tmp/sidecar/application-tls.json
# Production receipt listener: set its private bind address and port to enable.
# LANDING_RECEIPT_HOST=127.0.0.1
# LANDING_RECEIPT_PORT=3101
# Operator demo preparation selects a verified registry record, never a URL file.
# DEMO_ENGINE_ID=<verified engine UUID in this project>

# Released-under-custody deployment configuration (5.36). No secrets in Settings.
# OPINTEL_API_BASE_URL=https://application.example.com
# OPINTEL_CUSTODY_MASTER_KEY=<32 random bytes encoded as 64 lowercase hex characters>
# OPINTEL_XQ_API_KEY=<operator-provisioned XQ API key>
# OPINTEL_XQ_DASHBOARD_API_KEY=<operator-provisioned dashboard API key>
# OPINTEL_XQ_SENDER_ALIAS=<provider sender identity>
# OPINTEL_XQ_SENDER_ACCESS_TOKEN=<operator-provisioned sender access token>
# OPINTEL_XQ_REDEEM_URL=https://provider.example.com/redeem

# Optional dashboard bearer token for read-only dashboard authentication.
# OPINTEL_XQ_DASHBOARD_ACCESS_TOKEN=

# XQ tenant is per-project Settings custody.tenant, not a deployment secret/env var.

# Query admission health observation bounds (milliseconds).
# Reuse requires the configured authenticated ENGINE_HEARTBEAT_URL channel.
# Heartbeats never extend the age of a successful pinned health observation.
ENGINE_HEALTH_MAX_AGE_MS=30000
ENGINE_HEALTH_REFRESH_MS=5000
ENGINE_HEARTBEAT_MAX_AGE_MS=15000
