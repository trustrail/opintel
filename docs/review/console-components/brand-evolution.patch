-<tr data-example-state="focus"><th scope="row">Focus</th><td><label for="input-focus">Column name</label><input class="inp" id="input-focus" value="Region"></td><td><label for="select-focus">Operator</label><select class="sel" id="select-focus"><option>Equals</option><option>Does not equal</option></select></td></tr>
-<tr data-example-state="disabled"><th scope="row">Disabled</th><td><label for="input-disabled">Column name</label><input class="inp" id="input-disabled" value="Region" disabled></td><td><label for="select-disabled">Operator</label><select class="sel" id="select-disabled" disabled><option>Equals</option><option>Does not equal</option></select></td></tr>
